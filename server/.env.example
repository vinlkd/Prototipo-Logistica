# Node >=24. Use: node --env-file=server/.env server/index.js
# Development may omit AUTH_JWT_SECRET: a private local key is generated once.
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
AUTH_HOST=127.0.0.1
AUTH_PORT=3001
AUTH_DATA_DIR=.local/auth
# AUTH_JWT_SECRET=provide-at-least-32-random-bytes-in-production

# Optional in development. Required for real email delivery in production.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Logistica SENAI <nao-responda@example.com>
